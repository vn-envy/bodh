{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bodh.education/schemas/artifact.schema.json",
  "title": "Bodh deterministic learning artifact",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "artifactId",
    "kind",
    "conceptIds",
    "locale",
    "prompt",
    "equation",
    "canvas",
    "manipulatives",
    "successPredicate",
    "hints"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "artifactId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "kind": { "const": "fraction_fit" },
    "conceptIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^mt_[A-Za-z0-9_-]+$" }
    },
    "locale": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "terminologyMode"],
      "properties": {
        "primary": { "const": "hi-IN" },
        "terminologyMode": { "const": "hindi-first" }
      }
    },
    "prompt": { "$ref": "#/$defs/bilingualCopy" },
    "equation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw", "dividend", "divisor", "expectedQuotient"],
      "properties": {
        "raw": { "type": "string", "minLength": 1, "maxLength": 80 },
        "dividend": { "$ref": "#/$defs/rational" },
        "divisor": { "$ref": "#/$defs/rational" },
        "expectedQuotient": { "$ref": "#/$defs/rational" }
      }
    },
    "canvas": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wholeCount", "partitionDenominator", "highlightedParts"],
      "properties": {
        "wholeCount": { "type": "integer", "minimum": 1, "maximum": 8 },
        "partitionDenominator": { "type": "integer", "minimum": 2, "maximum": 24 },
        "highlightedParts": { "type": "integer", "minimum": 1, "maximum": 192 }
      }
    },
    "manipulatives": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "fraction", "count", "interaction"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" },
          "kind": { "const": "unit_tile" },
          "fraction": { "$ref": "#/$defs/rational" },
          "count": { "type": "integer", "minimum": 1, "maximum": 24 },
          "interaction": { "enum": ["tap-place-or-drag", "tap-place"] }
        }
      }
    },
    "successPredicate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "manipulativeId", "expectedCount"],
      "properties": {
        "type": { "const": "placed-tile-count-equals" },
        "manipulativeId": { "type": "string" },
        "expectedCount": { "type": "integer", "minimum": 1, "maximum": 24 }
      }
    },
    "hints": {
      "type": "array",
      "maxItems": 3,
      "items": { "$ref": "#/$defs/bilingualCopy" }
    }
  },
  "$defs": {
    "rational": {
      "type": "object",
      "additionalProperties": false,
      "required": ["numerator", "denominator"],
      "properties": {
        "numerator": { "type": "integer", "minimum": 0, "maximum": 999 },
        "denominator": { "type": "integer", "minimum": 1, "maximum": 999 }
      }
    },
    "bilingualCopy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hi"],
      "properties": {
        "hi": { "type": "string", "minLength": 1, "maxLength": 240 },
        "en": { "type": "string", "minLength": 1, "maxLength": 240 },
        "textbookTerms": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["hi", "en"],
            "properties": {
              "hi": { "type": "string", "minLength": 1, "maxLength": 40 },
              "en": { "type": "string", "minLength": 1, "maxLength": 40 }
            }
          }
        }
      }
    }
  }
}
