# The curated demo always runs without external services.
BODH_DEMO_MODE=true

# Phase 2 diagnostic intelligence. Keep the real value in .env.local and never commit it.
BODH_MODEL=gpt-5.6
OPENAI_API_KEY=

# Optional reviewed Bodh narration settings. The curated flow falls back to
# the device's Hindi speech voice when the hosted key is not configured.
BODH_TTS_MODEL=gpt-4o-mini-tts-2025-12-15
BODH_TTS_VOICE=marin
# Runtime generation is deliberately opt-in; fixed authored IDs and edge
# single-flight caching protect spend. Leave false when using reviewed clips.
BODH_TTS_RUNTIME_ENABLED=false

# Bodh Van: Sarvam Indic speech and language (see docs/SARVAM.md).
# Keep the real key in .env.local. When set, Bulbul v3 is preferred for
# Hindi/Tamil/English narration and Saaras v3 powers /api/speech/transcribe.
SARVAM_API_KEY=
BODH_SARVAM_TTS_MODEL=bulbul:v3
BODH_SARVAM_STT_MODEL=saaras:v3
BODH_SARVAM_SPEAKER_HI=shubh
BODH_SARVAM_SPEAKER_TA=shubh
BODH_SARVAM_SPEAKER_EN=shubh
# Speech-to-text provider for the browser doubt intake: "browser" (Web Speech API) or "sarvam".
BODH_STT_PROVIDER=browser
# Diagnosis and slot-fill provider: "openai" (default, recorded evals) or "sarvam" (sarvam-105b).
BODH_LLM_PROVIDER=openai
BODH_SARVAM_CHAT_MODEL=sarvam-105b
